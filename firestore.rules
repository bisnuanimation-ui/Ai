rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /prompts/{promptId} {
      allow read, write: if true;
    }

    match /adCampaigns/{campaignId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}

